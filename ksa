const byte buzzerPin = 8;
const byte ledPins[] = {2, 3, 4, 5, 6, 7};
const byte ledCount = 6;

// كل صف يحتوي على التردد ومدة النغمة
const unsigned int melody[][2] = {
  {349, 500}, {349, 125}, {349, 1200},
  {262, 300}, {349, 500}, {392, 125},
  {440, 300}, {466, 300}, {523, 1200},
  {523, 500}, {587, 125}, {523, 300},
  {466, 300}, {440, 300}, {392, 300},
  {349, 300}, {330, 300}, {349, 300},
  {523, 500}, {523, 125}, {523, 300},
  {587, 300}, {523, 500}, {466, 125},
  {440, 300}, {349, 300}, {523, 500},
  {523, 125}, {523, 300}, {698, 300},
  {659, 300}, {587, 300}, {523, 300},
  {523, 300}, {466, 500}, {466, 125},
  {466, 300}, {587, 300}, {523, 500},
  {466, 125}, {440, 300}, {349, 300},
